{
  "name": "@latticecms/cli",
  "version": "0.1.0",
  "description": "The lattice command: scaffolds collections and migrations, and runs migrations.",
  "keywords": [
    "lattice",
    "cms",
    "cli",
    "scaffold",
    "migrations"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crobinson42/lattice-cms.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/crobinson42/lattice-cms/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/crobinson42/lattice-cms/issues"
  },
  "bin": {
    "lattice": "./dist/bin.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome check .",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "@hexok/logger": "^0.2.0",
    "@latticecms/core": "^0.1.0",
    "@latticecms/store-mongo": "^0.1.0",
    "typescript": ">=5.8 <7"
  },
  "peerDependenciesMeta": {
    "@hexok/logger": {
      "optional": true
    },
    "@latticecms/store-mongo": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hexok/logger": "^0.2.0",
    "@latticecms/core": "*",
    "@latticecms/store-mongo": "*",
    "mongodb": "^7.9.1",
    "mongodb-memory-server": "^11.3.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.14"
    }
  }
}
