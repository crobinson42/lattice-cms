{
  "name": "@latticecms/store-mongo",
  "version": "0.0.0",
  "description": "The MongoDB CollectionStore for Lattice CMS.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome check .",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "hexok": "^2.2.7",
    "mongodb": "^7.9.1"
  },
  "peerDependencies": {
    "@latticecms/core": "*",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@latticecms/core": "*",
    "mongodb-memory-server": "^11.3.0",
    "zod": "^4.1.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.14"
    }
  }
}
