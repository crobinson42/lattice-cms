{
  "name": "@latticecms/store-mongo",
  "version": "0.0.0",
  "description": "The MongoDB CollectionStore for Lattice CMS.",
  "keywords": [
    "lattice",
    "cms",
    "mongodb",
    "store",
    "migrations"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crobinson42/lattice-cms.git",
    "directory": "packages/store-mongo"
  },
  "homepage": "https://github.com/crobinson42/lattice-cms/tree/main/packages/store-mongo#readme",
  "bugs": {
    "url": "https://github.com/crobinson42/lattice-cms/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.check.json && tsc -p tsconfig.dist.json",
    "lint": "biome check .",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "mongodb": "^7.9.1"
  },
  "peerDependencies": {
    "@hexok/logger": "^0.2.0",
    "@latticecms/core": "^0.1.0",
    "@opentelemetry/api": "^1.3.0",
    "hexok": "^2.2.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@hexok/logger": "^0.2.0",
    "@latticecms/core": "*",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/context-async-hooks": "^2.12.1",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "hexok": "^2.2.7",
    "mongodb-memory-server": "^11.3.0",
    "zod": "^4.1.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.14"
    }
  }
}
