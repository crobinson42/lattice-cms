{
  "name": "@latticecms/core",
  "version": "0.0.0",
  "description": "Collections that compile into hexok use cases and a ts-pf contract.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crobinson42/lattice-cms.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/crobinson42/lattice-cms/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/crobinson42/lattice-cms/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store/index.js",
      "default": "./dist/store/index.js"
    },
    "./store/conformance": {
      "types": "./dist/store/conformance.d.ts",
      "import": "./dist/store/conformance.js",
      "default": "./dist/store/conformance.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "src",
    "!src/**/*.test.ts",
    "!src/fixtures"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.check.json && tsc -p tsconfig.dist.json",
    "lint": "biome check .",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "@hexok/logger": "^0.2.0",
    "@opentelemetry/api": "^1.3.0",
    "@ts-pf/contract": "^1.0.0",
    "@ts-pf/docs": "^1.0.0",
    "@ts-pf/mcp": "^1.0.0",
    "@ts-pf/protocol": "^1.0.0",
    "@ts-pf/server": "^1.0.0",
    "hexok": "^2.2.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@hexok/logger": "^0.2.0",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/context-async-hooks": "^2.12.1",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@ts-pf/client": "^1.0.0",
    "@ts-pf/contract": "^1.0.0",
    "@ts-pf/docs": "^1.0.0",
    "@ts-pf/mcp": "^1.0.0",
    "@ts-pf/protocol": "^1.0.0",
    "@ts-pf/server": "^1.0.0",
    "@ts-pf/server-http": "^1.0.0",
    "hexok": "^2.2.7",
    "zod": "^4.1.0"
  }
}
