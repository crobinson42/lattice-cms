{
  "name": "@latticecms/workspace",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.11"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "lint": "node scripts/decisions.mjs --check && biome check scripts && turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "decisions": "node scripts/decisions.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.6.6",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.15.0",
    "turbo": "^2.5.6",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
