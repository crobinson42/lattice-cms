{
  "name": "@latticecms/example-crm",
  "version": "0.0.0",
  "private": true,
  "description": "A CRM on Lattice: three tenanted collections on MongoDB, served at /rpc and as MCP tools at /mcp.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/servers/http/main.js",
    "worker": "node dist/servers/worker/main.js",
    "dev:session": "node dist/servers/scripts/dev-session.js",
    "dev:user": "node dist/servers/scripts/dev-user.js",
    "openapi": "node dist/servers/scripts/openapi.js",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome check .",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@opentelemetry/context-async-hooks": "^2.12.1",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@ts-pf/client": "^0.6.0",
    "@ts-pf/client-http": "^0.6.0",
    "@ts-pf/codegen": "^0.6.0",
    "mongodb": "^7.9.1",
    "mongodb-memory-server": "^11.3.0"
  },
  "dependencies": {
    "@hexok/auth": "^0.1.1",
    "@hexok/auth-jose": "^0.1.0",
    "@hexok/auth-redis": "^0.1.0",
    "@hexok/integration-events": "^0.2.2",
    "@hexok/logger": "^0.2.0",
    "@hexok/queue": "^2.0.0",
    "@hexok/queue-redis": "^2.0.0",
    "@hexok/webhooks": "^0.1.0",
    "@latticecms/core": "*",
    "@latticecms/store-mongo": "*",
    "@modelcontextprotocol/server": "^2.4.0",
    "@opentelemetry/api": "~1.9.1",
    "@ts-pf/contract": "^0.6.0",
    "@ts-pf/docs": "^0.6.0",
    "@ts-pf/mcp": "^0.6.0",
    "@ts-pf/openapi": "^0.6.0",
    "@ts-pf/protocol": "^0.6.0",
    "@ts-pf/server": "^0.6.0",
    "@ts-pf/server-http": "^0.6.0",
    "hexok": "^2.2.7",
    "jose": "^6.2.18",
    "srvx": "^1.0.8",
    "zod": "^4.1.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.14"
    }
  }
}
