{
  "name": "@latticecms/example-crm",
  "version": "0.0.0",
  "private": true,
  "description": "A CRM on Lattice: three tenanted collections on MongoDB, served at /rpc.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/servers/http/main.js",
    "dev:session": "node dist/servers/scripts/dev-session.js",
    "dev:user": "node dist/servers/scripts/dev-user.js",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome check .",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@ts-pf/client": "^0.6.0",
    "mongodb": "^7.9.1",
    "mongodb-memory-server": "^11.3.0"
  },
  "dependencies": {
    "@hexok/auth": "^0.1.1",
    "@hexok/auth-jose": "^0.1.0",
    "@hexok/auth-redis": "^0.1.0",
    "@hexok/logger": "^0.2.0",
    "@latticecms/core": "*",
    "@latticecms/store-mongo": "*",
    "@ts-pf/contract": "^0.6.0",
    "@ts-pf/protocol": "^0.6.0",
    "@ts-pf/server": "^0.6.0",
    "@ts-pf/server-http": "^0.6.0",
    "hexok": "^2.2.7",
    "jose": "^6.2.18",
    "srvx": "^1.0.8",
    "zod": "^4.1.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.14"
    }
  }
}
