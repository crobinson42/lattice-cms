{
  "name": "@latticecms/example-crm",
  "version": "0.0.0",
  "private": true,
  "description": "A CRM on Lattice: companies, contacts, deals, activities and tasks, tenanted, on MongoDB, served at /rpc, as MCP tools at /mcp, and as an admin at /admin.",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env dist/servers/http/main.js",
    "dev": "node scripts/dev.mjs",
    "worker": "node --env-file-if-exists=.env dist/servers/worker/main.js",
    "seed": "node --env-file-if-exists=.env dist/servers/scripts/seed.js",
    "dev:session": "node --env-file-if-exists=.env dist/servers/scripts/dev-session.js",
    "dev:user": "node --env-file-if-exists=.env dist/servers/scripts/dev-user.js",
    "openapi": "node --env-file-if-exists=.env dist/servers/scripts/openapi.js",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.check.json && tsc -p tsconfig.web.json",
    "lint": "biome check .",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@latticecms/cli": "*",
    "@modelcontextprotocol/client": "^2.4.0",
    "@opentelemetry/context-async-hooks": "^2.12.1",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@tailwindcss/vite": "^4.3.5",
    "@ts-pf/codegen": "^1.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "mongodb": "^7.9.1",
    "mongodb-memory-server": "^11.3.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@hexok/auth": "^0.1.1",
    "@hexok/auth-jose": "^0.1.0",
    "@hexok/auth-redis": "^0.1.0",
    "@hexok/integration-events": "^0.2.2",
    "@hexok/logger": "^0.2.0",
    "@hexok/queue": "^2.0.0",
    "@hexok/queue-redis": "^2.0.0",
    "@hexok/webhooks": "^0.1.0",
    "@latticecms/admin": "*",
    "@latticecms/core": "*",
    "@latticecms/store-mongo": "*",
    "@modelcontextprotocol/server": "^2.4.0",
    "@opentelemetry/api": "~1.9.1",
    "@shadalaya/react": "^0.1.0",
    "@shadalaya/theme": "^0.1.0",
    "@ts-pf/client": "^1.0.1",
    "@ts-pf/client-http": "^1.0.1",
    "@ts-pf/contract": "^1.0.1",
    "@ts-pf/docs": "^1.0.1",
    "@ts-pf/mcp": "^1.0.1",
    "@ts-pf/openapi": "^1.0.1",
    "@ts-pf/protocol": "^1.0.1",
    "@ts-pf/server": "^1.0.1",
    "@ts-pf/server-http": "^1.0.1",
    "@ts-pf/swr": "^1.0.1",
    "hexok": "^2.2.8",
    "jose": "^6.2.18",
    "lucide-react": "^0.545.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "srvx": "^1.0.8",
    "swr": "^2.5.1",
    "wouter": "^3.13.0",
    "zod": "^4.1.0"
  },
  "lattice": {
    "tenant": "organizationId"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.14"
    }
  }
}
