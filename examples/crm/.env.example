# Local development settings for the crm, matching docker-compose.yml.
# Copy to .env (gitignored); every npm script loads it when it exists.

# The store: the compose replica set, by its member host.
MONGODB_URL=mongodb://localhost:27018/?replicaSet=rs0
MONGODB_DATABASE=crm

# Sessions, and the domain event, webhook and integration queues.
REDIS_URL=redis://localhost:6380

# Session tokens. This secret is for local development only: anyone can
# read it here, so never use it anywhere real. Make a real one with
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_TOKEN_SECRETS=bG9jYWwgZGV2ZWxvcG1lbnQgb25seSAtIG5ldmVyIHVzZSB0aGlzIHNlY3JldCBhbnl3aGVyZSByZWFs
AUTH_TOKEN_ISSUER=crm
AUTH_TOKEN_AUDIENCE=crm
AUTH_SESSION_IDLE_SECONDS=1800
AUTH_SESSION_ABSOLUTE_SECONDS=28800

# Sam Patel, whom npm run seed creates, acts as support.
CRM_SUPPORT_USER_IDS=sam

PORT=3000

# The worker's webhook endpoints, a JSON list; unset sends none.
# CRM_WEBHOOK_ENDPOINTS=[]
# 1 lets the worker send to plain http and private addresses.
# WEBHOOKS_ALLOW_PRIVATE=1
